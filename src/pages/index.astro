---
/**
 * 像素风首页：纵向滚动 = 小人向前跑，每屏停在一个新的群系，上方显示对应板块。
 * 世界由 src/pixel/world.ts 在 canvas 上实时生成；本页只负责内容与布局。
 * 没有 JS 时各板块按普通页面纵向排列，内容仍完整可读。
 */
import { getCollection } from 'astro:content';
import { site as siteConfig } from '../site';
import { getPosts, postUrl, formatDate as fmt } from '../lib/posts';

const posts = await getPosts();
const latest = posts.slice(0, 6);
const categoryCount = new Set(posts.flatMap((p) => p.data.categories)).size;
const friends = (await getCollection('friends')).map((e) => e.data);
const tools = (await getCollection('tools')).map((e) => e.data);

const sections = [
  { id: 'home', label: '起点', biome: '草原' },
  { id: 'posts', label: '博文', biome: '森林' },
  { id: 'tools', label: '工具', biome: '沙漠' },
  { id: 'server', label: '服务器', biome: '村庄' },
  { id: 'friends', label: '友链', biome: '樱花林' },
  { id: 'about', label: '关于', biome: '雪原' },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{siteConfig.title}</title>
    <meta name="description" content={siteConfig.description} />
    <link rel="canonical" href={siteConfig.url + '/'} />
    <link rel="icon" href="/assets/img/avatar/avatar.png" />
    <link rel="alternate" type="application/rss+xml" title={siteConfig.title} href="/feed.xml" />
    <meta property="og:title" content={siteConfig.title} />
    <meta property="og:description" content={siteConfig.description} />
    <meta name="theme-color" content="#eef1f5" />
    <script is:inline>
      (() => {
        const d = document.documentElement;
        d.classList.add('js');
        let t = null;
        try { t = localStorage.getItem('theme'); } catch {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        d.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    <canvas id="world" aria-hidden="true"></canvas>

    <header class="topbar">
      <a class="brand" href="/" aria-label="MickeyMiao 首页"><span class="brand-dot" aria-hidden="true"></span>MickeyMiao</a>
      <nav class="toplinks" aria-label="站点">
        <a href="/archives/">归档</a>
        <a href="/browse/">分类</a>
        <a href="/feed.xml">RSS</a>
        <button type="button" class="theme-btn" data-theme-toggle aria-label="切换深色模式">
          <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5" /><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" /></svg>
          <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
        </button>
      </nav>
    </header>

    <main>
      {sections.map((s, i) => (
        <section id={s.id} class="stage" aria-labelledby={`${s.id}-title`}>
          <div class="panel" data-panel={i}>
            <div class="card">
              <h2 class="card-title" id={`${s.id}-title`}>
                <span class="title-dot" aria-hidden="true"></span>
                <span>{s.label}</span>
                <span class="biome-chip">{s.biome}</span>
              </h2>

              {s.id === 'home' && (
                <div class="hero">
                  <img class="avatar" src="/assets/img/avatar/avatar.png" alt="" width="96" height="96" />
                  <div>
                    <p class="hero-name">{siteConfig.title}</p>
                    <p class="hero-tag">{siteConfig.tagline}</p>
                    <p class="hero-meta">{posts.length} 篇文章 · {categoryCount} 个分类 · {friends.length} 位朋友</p>
                  </div>
                  <p class="hint">向下滑动，出发 <span aria-hidden="true">▼</span><span class="hint-keys">（或按 1-{sections.length} 直达）</span></p>
                </div>
              )}

              {s.id === 'posts' && (
                <>
                  <ol class="post-list">
                    {latest.map((post) => (
                      <li>
                        <a href={postUrl(post)}>
                          <span class="post-title">{post.data.pin && <span class="pin">置顶</span>}{post.data.title}</span>
                          <span class="post-meta">
                            <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
                            {post.data.categories.length > 0 && <span> · {post.data.categories.join(' / ')}</span>}
                          </span>
                        </a>
                      </li>
                    ))}
                  </ol>
                  <p class="more"><a class="btn" href="/archives/">全部文章</a><a class="btn" href="/browse/">分类与标签</a></p>
                </>
              )}

              {s.id === 'tools' && (
                <ul class="grid">
                  {tools.map((t) => (
                    <li>
                      <a class="slot-link" href={t.url}>
                        <span class="item-name">{t.name}</span>
                        <span class="item-desc">{t.description}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              )}

              {s.id === 'server' && (
                <div class="server" data-mc-status>
                  <p class="server-desc">我和朋友们的 Minecraft 生存服，白名单制，跑在家里的一台小主机上。</p>
                  <dl class="stats">
                    <div><dt>状态</dt><dd data-k="state">读取中…</dd></div>
                    <div><dt>在线</dt><dd data-k="players">-</dd></div>
                    <div><dt>版本</dt><dd data-k="version">-</dd></div>
                    <div><dt>已运行</dt><dd data-k="uptime">-</dd></div>
                  </dl>
                  <p class="server-foot" data-k="updated">每 10 分钟更新一次</p>
                </div>
              )}

              {s.id === 'friends' && (
                <>
                  <ul class="grid friends">
                    {friends.map((f) => (
                      <li>
                        <a class="slot-link" href={f.url} target="_blank" rel="noopener">
                          {f.icon ? (
                            <img src={f.icon} alt="" width="32" height="32" loading="lazy" referrerpolicy="no-referrer" />
                          ) : (
                            <span class="noicon" aria-hidden="true">{f.name.slice(0, 1)}</span>
                          )}
                          <span>
                            <span class="item-name">{f.name}</span>
                            {f.description && <span class="item-desc">{f.description}</span>}
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                  <p class="more"><a class="btn" href="/friends/">友链页面</a></p>
                </>
              )}

              {s.id === 'about' && (
                <div class="about">
                  <p class="hero-name">嗨，我是王思淼</p>
                  <p>图形渲染开发工程师 @ 小米。喜欢图形学、游戏和折腾服务器。</p>
                  <p class="more">
                    <a class="btn" href="/about/">完整介绍</a>
                    <a class="btn" href={siteConfig.links.github} target="_blank" rel="noopener">GitHub</a>
                    <a class="btn" href={siteConfig.links.bilibili} target="_blank" rel="noopener">Bilibili</a>
                    <a class="btn" href={siteConfig.links.steam} target="_blank" rel="noopener">Steam</a>
                  </p>
                </div>
              )}
            </div>
          </div>
        </section>
      ))}
    </main>

    <nav class="hotbar" aria-label="板块">
      {sections.map((s, i) => (
        <a class="hb-slot" href={`#${s.id}`} title={`${s.label}（${i + 1}）`}>
          <span class="hb-num" aria-hidden="true">{i + 1}</span>
          <span class="hb-label">{s.label}</span>
        </a>
      ))}
    </nav>

    <script>
      import { startWorld } from '../pixel/world';

      const canvas = document.getElementById('world') as HTMLCanvasElement;
      startWorld({
        canvas,
        sections: [...document.querySelectorAll<HTMLElement>('.stage')],
        panels: [...document.querySelectorAll<HTMLElement>('.panel')],
        slots: [...document.querySelectorAll<HTMLElement>('.hb-slot')],
      });

      // 深色模式切换
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const d = document.documentElement;
        const next = d.dataset.theme === 'dark' ? 'light' : 'dark';
        d.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
      });

      // MC 状态：由 mc-ops 每 10 分钟推到 mc-status 仓库的 Pages（同域）
      const box = document.querySelector<HTMLElement>('[data-mc-status]');
      if (box) {
        const set = (k: string, v: string) => {
          const el = box.querySelector(`[data-k="${k}"]`);
          if (el) el.textContent = v;
        };
        fetch('/mc-status/status.json', { cache: 'no-store' })
          .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
          .then((s) => {
            set('state', s.online ? '在线' : '离线');
            box.dataset.online = s.online ? '1' : '0';
            set('players', s.online ? `${s.players_online ?? 0} / ${s.players_max ?? '?'}` : '-');
            set('version', s.version ?? '-');
            const up = Number(s.uptime_s ?? 0);
            set('uptime', s.online && up ? `${Math.floor(up / 3600)} 小时 ${Math.floor((up % 3600) / 60)} 分` : '-');
            if (s.updated_at) {
              const min = Math.round((Date.now() - new Date(s.updated_at).getTime()) / 60000);
              set('updated', min > 30 ? `数据已 ${min} 分钟未更新，小主机可能离线` : `${Math.max(0, min)} 分钟前更新`);
            }
          })
          .catch(() => {
            set('state', '数据接入中');
            set('updated', '状态数据还没上线（mc-status）');
          });
      }
    </script>
  </body>
</html>

<style is:global>
  /* 像素只留在下方的世界里；界面是轻拟物：同色系表面 + 一亮一暗两道柔光营造凸起 */
  :root {
    --px: 4px;
    --stage: 200px;
    --ground: 128px;
    --tint: #cdebff;
    --radius: 22px;
    --font: 'Inter', 'PingFang SC', 'HarmonyOS Sans SC', 'Microsoft YaHei', system-ui, sans-serif;
    --mono: ui-monospace, 'SFMono-Regular', 'JetBrains Mono', Menlo, monospace;
  }
  [data-theme='light'] {
    color-scheme: light;
    --bg: #eef1f5;
    --surface: #f2f4f8;
    --surface-hi: #f7f9fc;
    --surface-lo: #e9edf2;
    --sh-dark: rgb(163 177 198 / 0.55);
    --sh-light: rgb(255 255 255 / 0.95);
    --edge: rgb(255 255 255 / 0.7);
    --text: #2b313c;
    --muted: #7a8394;
    --accent: #3a9a30;
    --accent-soft: rgb(58 154 48 / 0.12);
    --world-filter: none;
  }
  [data-theme='dark'] {
    color-scheme: dark;
    --bg: #15181d;
    --surface: #1a1e24;
    --surface-hi: #1f242b;
    --surface-lo: #171a1f;
    --sh-dark: rgb(0 0 0 / 0.55);
    --sh-light: rgb(255 255 255 / 0.045);
    --edge: rgb(255 255 255 / 0.05);
    --text: #e3e7ee;
    --muted: #8b93a3;
    --accent: #7ccf5c;
    --accent-soft: rgb(124 207 92 / 0.12);
    --world-filter: brightness(0.62) saturate(0.85);
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; }
  body {
    font-family: var(--font);
    color: var(--text);
    background: var(--bg);
    overflow-x: hidden;
    transition: background-color 0.3s;
  }
  a { color: inherit; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  /* ---- 背景：地平线一层淡淡的群系色，向上融进页面底色 ---- */
  .js body::before {
    content: '';
    position: fixed;
    inset: 0;
    background: linear-gradient(to bottom, transparent 40%, color-mix(in srgb, var(--tint) 32%, transparent) 100%);
    pointer-events: none;
  }
  #world {
    position: fixed;
    inset: 0;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
    display: none;
    /* 像素世界自下而上淡出 */
    -webkit-mask-image: linear-gradient(to bottom, transparent 38%, rgb(0 0 0 / 0.12) 52%, rgb(0 0 0 / 0.55) 66%, #000 82%);
    mask-image: linear-gradient(to bottom, transparent 38%, rgb(0 0 0 / 0.12) 52%, rgb(0 0 0 / 0.55) 66%, #000 82%);
    filter: var(--world-filter);
    transition: filter 0.3s;
  }
  .js #world { display: block; }
  html.js { scroll-snap-type: y mandatory; scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) { html.js { scroll-behavior: auto; } body, #world { transition: none; } }

  /* ---- 顶栏 ---- */
  .topbar {
    position: fixed; z-index: 3; top: 0; left: 0; right: 0;
    display: flex; justify-content: space-between; align-items: center;
    padding: 16px 22px; pointer-events: none;
  }
  .topbar a, .topbar button { pointer-events: auto; }
  .brand {
    display: inline-flex; align-items: center; gap: 10px;
    font-weight: 700; font-size: 18px; letter-spacing: 0.3px; text-decoration: none;
  }
  .brand-dot {
    width: 10px; height: 10px; background: var(--accent);
    box-shadow: 10px 0 0 color-mix(in srgb, var(--accent) 55%, transparent), 0 10px 0 color-mix(in srgb, var(--accent) 35%, transparent);
    margin-right: 10px;
  }
  .toplinks { display: flex; gap: 10px; align-items: center; }
  .toplinks a, .theme-btn {
    font: inherit; font-size: 13px; color: var(--muted); text-decoration: none;
    padding: 7px 13px; border-radius: 12px; border: 0; cursor: pointer;
    background: var(--surface);
    box-shadow: 4px 4px 10px var(--sh-dark), -4px -4px 10px var(--sh-light);
    transition: box-shadow 0.15s, color 0.15s;
  }
  .toplinks a:hover, .theme-btn:hover { color: var(--accent); }
  .toplinks a:active, .theme-btn:active { box-shadow: inset 3px 3px 7px var(--sh-dark), inset -3px -3px 7px var(--sh-light); }
  .theme-btn { display: grid; place-items: center; padding: 7px 9px; }
  .theme-btn svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; }
  .theme-btn .i-moon { fill: currentColor; stroke: none; }
  [data-theme='light'] .i-moon, [data-theme='dark'] .i-sun { display: none; }

  /* ---- 每屏 ---- */
  .stage { min-height: 100vh; min-height: 100dvh; scroll-snap-align: start; scroll-snap-stop: always; padding: 72px 16px 24px; }
  .js .stage { height: 100vh; height: 100dvh; padding: 0; }

  .panel { max-width: 760px; margin: 0 auto 28px; }
  .js .panel {
    position: fixed; z-index: 2;
    top: 72px; bottom: var(--stage);
    left: 50%; width: min(760px, calc(100vw - 32px)); margin-left: calc(min(760px, calc(100vw - 32px)) / -2);
    display: flex; flex-direction: column; justify-content: flex-end;
    will-change: transform, opacity;
  }

  /* ---- 凸起卡片 ---- */
  .card {
    position: relative;
    max-height: 100%;
    overflow: auto;
    padding: 26px 28px 24px;
    border-radius: var(--radius);
    background: linear-gradient(145deg, var(--surface-hi), var(--surface-lo));
    box-shadow: 14px 14px 32px var(--sh-dark), -12px -12px 28px var(--sh-light), inset 1px 1px 0 var(--edge);
    scrollbar-width: thin;
  }
  .card-title { margin: 0 0 18px; display: flex; align-items: center; gap: 10px; font-size: 20px; font-weight: 700; }
  /* 唯一的像素元素：标题前的一颗方块 */
  .title-dot { width: 8px; height: 8px; background: var(--accent); box-shadow: 8px 8px 0 color-mix(in srgb, var(--accent) 40%, transparent); margin-right: 8px; }
  .biome-chip {
    margin-left: auto; font-size: 12px; font-weight: 500; color: var(--muted);
    padding: 4px 12px; border-radius: 999px;
    box-shadow: inset 2px 2px 5px var(--sh-dark), inset -2px -2px 5px var(--sh-light);
  }

  .btn {
    display: inline-block; text-decoration: none; padding: 9px 16px; margin: 0 10px 10px 0;
    border-radius: 12px; font-size: 14px; color: var(--text); background: var(--surface);
    box-shadow: 5px 5px 12px var(--sh-dark), -5px -5px 12px var(--sh-light);
    transition: box-shadow 0.15s, color 0.15s;
  }
  .btn:hover { color: var(--accent); }
  .btn:active { box-shadow: inset 3px 3px 8px var(--sh-dark), inset -3px -3px 8px var(--sh-light); }

  /* 起点 */
  .hero { display: grid; grid-template-columns: auto 1fr; gap: 22px; align-items: center; }
  .avatar {
    width: 104px; height: 104px; border-radius: 26px; padding: 6px; background: var(--surface);
    box-shadow: 6px 6px 14px var(--sh-dark), -6px -6px 14px var(--sh-light);
    image-rendering: auto;
  }
  .hero-name { margin: 0 0 6px; font-size: 26px; font-weight: 800; letter-spacing: 0.2px; }
  .hero-tag { margin: 0 0 10px; color: var(--muted); font-family: var(--mono); font-size: 14px; }
  .hero-meta { margin: 0; font-size: 13px; color: var(--muted); }
  .hint { grid-column: 1 / -1; margin: 6px 0 0; font-size: 14px; color: var(--muted); }
  .hint span[aria-hidden] { display: inline-block; color: var(--accent); animation: bob 1.4s ease-in-out infinite; }
  .hint-keys { font-size: 12px; opacity: 0.8; }
  @keyframes bob { 50% { transform: translateY(3px); } }
  @media (prefers-reduced-motion: reduce) { .hint span[aria-hidden] { animation: none; } }

  /* 博文：悬停时「按下去」 */
  .post-list { list-style: none; margin: 0 0 16px; padding: 0; display: grid; gap: 4px; }
  .post-list a {
    display: flex; justify-content: space-between; align-items: baseline; gap: 16px; text-decoration: none;
    padding: 10px 14px; border-radius: 14px; transition: box-shadow 0.15s;
  }
  .post-list a:hover, .post-list a:focus-visible { box-shadow: inset 3px 3px 8px var(--sh-dark), inset -3px -3px 8px var(--sh-light); }
  .post-list a:hover .post-title { color: var(--accent); }
  .post-title { font-weight: 600; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; transition: color 0.15s; }
  .post-meta { flex: none; font-size: 12px; color: var(--muted); font-variant-numeric: tabular-nums; }
  .pin { color: var(--accent); background: var(--accent-soft); font-size: 11px; padding: 2px 7px; border-radius: 6px; margin-right: 8px; }
  .more { margin: 0; }

  /* 工具 / 友链：小凸块 */
  .grid { list-style: none; margin: 0 0 18px; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 14px; }
  .slot-link {
    display: flex; gap: 12px; align-items: center; height: 100%; text-decoration: none;
    padding: 12px 14px; border-radius: 16px; background: var(--surface);
    box-shadow: 5px 5px 12px var(--sh-dark), -5px -5px 12px var(--sh-light);
    transition: box-shadow 0.15s;
  }
  .slot-link:hover { box-shadow: 2px 2px 6px var(--sh-dark), -2px -2px 6px var(--sh-light); }
  .slot-link:hover .item-name { color: var(--accent); }
  .slot-link:active { box-shadow: inset 3px 3px 8px var(--sh-dark), inset -3px -3px 8px var(--sh-light); }
  .slot-link img, .noicon { width: 36px; height: 36px; flex: none; border-radius: 10px; object-fit: cover; background: var(--surface-lo); }
  .noicon { display: grid; place-items: center; font-weight: 700; color: var(--accent); }
  .item-name { display: block; font-weight: 600; transition: color 0.15s; }
  .item-desc { display: block; font-size: 12px; color: var(--muted); margin-top: 3px; }

  /* 服务器：凹槽数据格 */
  .server-desc { margin: 0 0 16px; color: var(--muted); }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin: 0 0 14px; }
  .stats div { padding: 12px 14px; border-radius: 16px; box-shadow: inset 4px 4px 10px var(--sh-dark), inset -4px -4px 10px var(--sh-light); }
  .stats dt { font-size: 12px; color: var(--muted); }
  .stats dd { margin: 6px 0 0; font-size: 17px; font-weight: 700; font-variant-numeric: tabular-nums; }
  [data-online='1'] .stats dd[data-k='state'] { color: var(--accent); }
  [data-online='0'] .stats dd[data-k='state'] { color: #d9534f; }
  .server-foot { margin: 0; font-size: 12px; color: var(--muted); }

  .about p { margin: 0 0 12px; }
  .about p:not(.hero-name):not(.more) { color: var(--muted); }

  /* ---- 底部板块切换：凸起底座，当前项按下 ---- */
  .hotbar { display: none; }
  .js .hotbar {
    position: fixed; z-index: 3; left: 50%; transform: translateX(-50%);
    bottom: max(10px, calc(var(--ground) / 2 - 26px));
    display: flex; gap: 4px; padding: 6px; border-radius: 18px;
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
    box-shadow: 8px 8px 20px rgb(0 0 0 / 0.22), -4px -4px 12px var(--sh-light), inset 1px 1px 0 var(--edge);
  }
  .hb-slot {
    position: relative; min-width: 62px; height: 40px; padding: 0 12px; display: grid; place-items: center;
    text-decoration: none; color: var(--muted); font-size: 13px; border-radius: 13px;
    transition: box-shadow 0.15s, color 0.15s;
  }
  .hb-num { position: absolute; top: 3px; left: 7px; font-size: 9px; font-family: var(--mono); opacity: 0.6; }
  .hb-slot:hover { color: var(--text); }
  .hb-slot.is-active { color: var(--accent); font-weight: 600; box-shadow: inset 3px 3px 7px var(--sh-dark), inset -3px -3px 7px var(--sh-light); }

  @media (max-width: 640px) {
    .topbar { padding: 12px 14px; }
