{
  "name": "mickeymiao-blog",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "MickeyMiao 的个人博客",
  "homepage": "https://blog.mickeymiao.cn",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning build/dev.mjs",
    "build": "node --disable-warning=ExperimentalWarning build/build.mjs",
    "check-friends": "node build/check-friends.mjs",
    "verify": "node build/verify.mjs",
    "test": "node --disable-warning=ExperimentalWarning --import ./tests/register.mjs --test \"tests/unit/*.test.*\"",
    "test:e2e": "node tests/e2e/flow.mjs",
    "pretest": "node build/atlas.mjs"
  },
  "dependencies": {
    "highlight.js": "11.12.0",
    "katex": "0.19.0",
    "markdown-it": "15.0.3",
    "yaml": "2.9.1"
  }
}
