{
  // 只给编辑器和可选的类型检查用（npx -p typescript tsc -p .），构建本身不依赖 TypeScript
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023", "dom", "dom.iterable"],
    // WebGPU 的类型（TypeScript 自带的 dom 库里还没有），只有类型声明，不进页面
    "types": ["@webgpu/types"],
    "strict": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  "include": ["src/assets/js/**/*.ts"]
}
